<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/oepl_blink_swatch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/oepl_blink_group_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/oepl_blink_group_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/oepl_blink_red_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/oepl_blink_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="7" />

    <TextView
        android:id="@+id/oepl_blink_green_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/oepl_blink_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="7" />

    <TextView
        android:id="@+id/oepl_blink_blue_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/oepl_blink_blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="3" />

    <TextView
        android:id="@+id/oepl_blink_flashes_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/oepl_blink_flashes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="15" />

    <TextView
        android:id="@+id/oepl_blink_gap_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/oepl_blink_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="15" />
</LinearLayout>
