<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/oepl_blink_hint"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oepl_blink_saved"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/oepl_blink_saved" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oepl_blink_save"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/oepl_blink_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oepl_blink_presets"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/oepl_blink_presets" />

            <TextView
                android:id="@+id/oepl_blink_brightness_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/oepl_blink_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15" />

            <TextView
                android:id="@+id/oepl_blink_rounds_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/oepl_blink_rounds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="49" />

            <LinearLayout
                android:id="@+id/oepl_blink_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/oepl_blink_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oepl_blink_reset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/oepl_blink_reset" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/oepl_blink_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="@string/oepl_blink_test" />
</LinearLayout>
